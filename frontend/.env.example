# Base URL API (tanpa trailing slash, seduai dengan path /api/v1 backend).
# Dev memakai proxy Vite (/api => http://127.0.0.1:8000).
# Production: isi dengan URL API absolut, contoh https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1
# Base URL publik untuk canonical/OG; di production isi dengan domain, mis. https://nama-domain.com
VITE_SITE_URL=http://localhost:5173
