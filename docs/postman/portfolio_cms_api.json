        { "name": "Delete Media", "request": { "method": "DELETE", "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/v1/admin/media/1", "host": ["{{base_url}}"], "path": ["api", "v1", "admin", "media", "1"] } } }
